# ───────────────────────── SIPREF Reservas · Frontend ─────────────────────────
# Copia este archivo a `.env.local` para desarrollo. No guardes secretos aquí.

# [Servidor · Vercel] URL pública del backend en Render, SIN barra final.
# La usa únicamente middleware.ts (Vercel Routing Middleware) para reenviar /api/*.
# No lleva prefijo VITE_, por lo que nunca llega al navegador.
API_URL=https://sipref-reservas-api.onrender.com

# [Público · opcional] Client ID de Google OAuth. Solo se muestra con fines de diagnóstico;
# el inicio de sesión usa el flujo de código del servidor (/api/auth/google/iniciar).
VITE_GOOGLE_CLIENT_ID=

# [Desarrollo] Destino del proxy de Vite para /api (por defecto http://localhost:4000).
VITE_DEV_API_TARGET=http://localhost:4000

# [Desarrollo] true = usa datos simulados en el navegador (MSW) en lugar del backend.
VITE_USE_MOCKS=false
