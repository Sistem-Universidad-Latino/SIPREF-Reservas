# =============================================================================
# SIPREF Reservas · Variables de entorno del backend (apps/api)
# =============================================================================
# Copiar a .env para desarrollo local. NUNCA subir secretos reales a Git.

# Puerto HTTP del servidor y entorno de ejecución ('development' | 'test' | 'production')
PORT=4000
NODE_ENV=development

# Confiar en encabezados X-Forwarded-* del proxy inverso (Render / Vercel)
TRUST_PROXY=true

# Conexión a PostgreSQL (usar rol sipref_reservas_app de privilegio mínimo)
# En local apunta al contenedor de db/local/docker-compose.yml (puerto 5433)
DATABASE_URL=postgres://sipref_reservas_app:app_local_dev@localhost:5433/sipref
# Modo TLS hacia PostgreSQL: 'false' (local), 'true' (producción estricta), 'no-verify' (certificado autofirmado)
DATABASE_SSL=false

# URL pública del frontend (el callback de Google es ${FRONTEND_URL}/api/auth/google/callback)
FRONTEND_URL=http://localhost:5173

# Credenciales OAuth 2.0 de Google Cloud Console (flujo Authorization Code + PKCE)
GOOGLE_CLIENT_ID=000000000000-placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-placeholder_secret_solo_local

# Secreto para firmar cookies (sr_estado, sr_oauth) — mínimo 32 caracteres
SESSION_SECRET=reemplazar_por_secreto_aleatorio_de_al_menos_32_caracteres_local

# Restricción opcional de dominios de correo separados por coma (vacío = usa config de BD o permite cualquier cuenta Google)
DOMINIOS_PERMITIDOS=

# Días de vigencia de una solicitud de acceso PENDIENTE antes de expirar
SOLICITUD_EXPIRACION_DIAS=30

# Credenciales HMAC para la API de integración servidor a servidor (SIPREF principal -> SIPREF Reservas)
INTEGRACION_KEY_ID=sipref-principal-local
INTEGRACION_SECRET=reemplazar_por_secreto_hmac_integracion_local_32_chars
# Lista opcional de IPs permitidas (separadas por coma) para invocar /api/integracion/v1/*
INTEGRACION_IPS_PERMITIDAS=

# Webhook saliente opcional (SIPREF Reservas -> SIPREF principal)
PRINCIPAL_WEBHOOK_URL=
PRINCIPAL_WEBHOOK_SECRET=

# Endpoint opcional de bitácora centralizada en SIPREF principal
PRINCIPAL_BITACORA_URL=

# Configuración SMTP opcional para envío de correos (aprobación de acceso y recordatorios)
# Si SMTP_HOST está vacío en desarrollo, los correos se registran en consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SIPREF Reservas <no-responder@ulatino.edu.mx>"

# Secreto compartido para el cron job (POST /api/tareas/ejecutar con encabezado X-Cron-Secret)
CRON_SECRET=reemplazar_por_secreto_cron_local_minimo_16_chars

# SOLO DESARROLLO/PRUEBAS: habilita POST /api/auth/dev para simular login sin Google.
# El servidor se niega a arrancar si AUTH_DEV_BYPASS=true con NODE_ENV=production.
AUTH_DEV_BYPASS=true
